void loop() {
  
  transmitSignal_ON(); // Generate the signal
  delay(10000); //10s delay
  
  transmitSignal_OFF(); // Generate the signal
  delay(10000); //10s delay
}

void transmitSignal_ON() {
  noInterrupts(); // Disable interrupts for precise timing

  for (uint16_t i = 0; i < NUM_STEPS; i++) {
    uint8_t state = pgm_read_byte_near(offstates + i);
    uint16_t duration = pgm_read_word_near(ondurations + i);

    if (state)
      PORTB |= (1 << PORTB0); // Set pin HIGH
    else
      PORTB &= ~(1 << PORTB0); // Set pin LOW

    delayMicroseconds(duration);
  }

  interrupts(); // Re-enable interrupts after signal generation
}

void transmitSignal_OFF() {
  noInterrupts(); // Disable interrupts for precise timing

  for (uint16_t i = 0; i < NUM_STEPS; i++) {
    uint8_t state = pgm_read_byte_near(offstates + i);
    uint16_t duration = pgm_read_word_near(offdurations + i);
      
    if (state)
      PORTB |= (1 << PORTB0); // Set pin HIGH
    else
      PORTB &= ~(1 << PORTB0); // Set pin LOW

    delayMicroseconds(duration);
  }

  interrupts(); // Re-enable interrupts after signal generation  
}

